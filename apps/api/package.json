{
  "name": "@openapply/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "module": "src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "types": "./src/app.ts",
  "scripts": {
    "dev": "bun run --watch src/app.ts",
    "start": "bun run src/app.ts",
    "build": "bun build --compile --minify --target bun-windows-x64 --outfile dist/server.exe src/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prebuild": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --create-only",
    "db:migrate:apply": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --skip-seed"
  },
  "dependencies": {
    "@2captcha/captcha-solver": "^1.3.9",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@openapply/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "dotenv": "^18.0.4",
    "elysia": "^1.4.30",
    "googleapis": "^182.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "tsyringe": "^4.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
