enum JobListingStatus {
  published
  hidden

  @@map("job_listing_status")
}

enum JobLevel {
  intern
  entry
  mid
  senior
  lead
  executive
  unknown

  @@map("job_level")
}

// The public job index: one row per posting, deduped across every user's campaigns. Digest fields
// only - it must never carry who discovered or applied. Grows into the fleet-wide shared job index.
model JobListing {
  id        String @id @default(uuid())
  slug      String @unique
  // sha256(normTitle|normCompany|normLocation). Not to be confused with `Job.digest`, which is the
  // agent's JSON content summary, not a hash.
  dedupeKey String @unique @map("dedupe_key")

  title              String
  company            String
  location           String?
  remote             Boolean  @default(false)
  salary             String?
  employmentType     String?  @map("employment_type")
  skills             String[] @map("skills")
  descriptionExcerpt String?  @map("description_excerpt")
  // From the agent's digest. Empty until a posting is re-scraped - there is no backfill.
  requirements       String[] @map("requirements")
  responsibilities   String[] @map("responsibilities")
  yearsExperience    Int?     @map("years_experience")
  level              JobLevel @default(unknown)

  // Auto-published behind the ingest quality gate; admins hide after the fact.
  status      JobListingStatus @default(published)
  firstSeenAt DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime         @default(now()) @map("last_seen_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sources JobListingSource[]

  // Serves the default list and the sitemap: `where status ORDER BY last_seen_at DESC`.
  @@index([status, lastSeenAt])
  // `?tech=` is a `skills @> ARRAY[..]` containment test - btree cannot serve it.
  @@index([skills], type: Gin)
  // Trigram indexes serve the `?q=` ILIKE '%term%' search.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_listings_title_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_listings_company_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_listings_location_trgm_idx")
  @@map("job_listings")
}

// Where one posting was seen. A repost across boards collapses into one JobListing with several
// sources; `url @unique` is what keeps the ingest upsert atomic under concurrent agents.
model JobListingSource {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  // Stored lowercase, so `?board=` is an equality hit rather than an ILIKE scan.
  board      String?
  // Canonicalized (tracking params stripped) - see canonicalizeUrl in dedupe.ts.
  url        String   @unique
  applyUrl String? @map("apply_url")
  attributionUrl String? @map("attribution_url")
  resolutionConfidence Float? @map("resolution_confidence")
  postedAt DateTime? @map("posted_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([board, listingId])
  @@map("job_listing_sources")
}

enum AtsProvider {
 ashby
 greenhouse
 lever
 smartrecruiters
 workable
 @@map("ats_provider")
}
enum DiscoveryProvider {
 apify
 serpapi
 @@map("discovery_provider")
}
model CompanyAtsBoard {
  companyKey String @id @map("company_key")
  provider AtsProvider
  slug String
  checkedAt DateTime @default(now()) @map("checked_at")
  @@map("company_ats_boards")
}

model JobSourceConnection {
  userId String @map("user_id")
  provider DiscoveryProvider
  enabled Boolean @default(false)
  encryptedKey String @map("encrypted_key")
  config Json @default("{}")
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,provider])
  @@map("job_source_connections")
}
