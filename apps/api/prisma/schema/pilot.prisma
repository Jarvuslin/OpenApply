enum PilotQuestionKind {
  question
  choice
  two_factor
  approval

  @@map("pilot_question_kind")
}

enum PilotQuestionStatus {
  open
  answered
  expired
  cancelled

  @@map("pilot_question_status")
}

enum PilotJournalKind {
  cycle
  action
  observation
  question
  system
  digest
  correction

  @@map("pilot_journal_kind")
}

enum PromotionStatus {
  draft
  approved
  declined
  posted
  failed
  skipped
  expired

  @@map("promotion_status")
}

model PilotState {
  userId                String    @id @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  running               Boolean   @default(false)
  instructionsGoals     String    @default("") @map("instructions_goals")
  instructionsConfig    Json      @default("{}") @map("instructions_config")
  instructionsUpdatedAt DateTime? @map("instructions_updated_at")
  agendaVersion         String?   @map("agenda_version")
  agendaGeneratedAt     DateTime? @map("agenda_generated_at")
  agendaExpiresAt       DateTime? @map("agenda_expires_at")
  agendaSnapshot        Json?     @map("agenda_snapshot")
  lastCycleAt           DateTime? @map("last_cycle_at")
  cycleCount            Int       @default(0) @map("cycle_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("pilot_states")
}

model PilotSearch {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        String
  board        String?
  resumeId     String?   @map("resume_id")
  // The pilot's one-liner on why it chose this search, shown verbatim in the web UI.
  reason       String    @default("")
  lastRunAt    DateTime? @map("last_run_at")
  lastJobsSeen Int?      @map("last_jobs_seen")
  lastNewJobs  Int?      @map("last_new_jobs")
  // Consecutive runs with zero new jobs; drives the dry-search backoff, "backing off" >= 3.
  emptyRuns    Int       @default(0) @map("empty_runs")
  nextRunAt    DateTime  @default(now()) @map("next_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Campaigns this search spawned; a completed one is left behind when the next run opens a new campaign.
  campaigns Campaign[]

  @@index([userId, nextRunAt])
  @@map("pilot_searches")
}

enum CheckpointDecision {
  approve
  skip
  @@map("checkpoint_decision")
}

model PilotQuestion {
  approval Json?
  approvalAttemptId String? @map("approval_attempt_id")
  approvalCheckpointId String? @map("approval_checkpoint_id")
  approvalCheckpointHash String? @map("approval_checkpoint_hash")
  approvalJobUpdatedAt DateTime? @map("approval_job_updated_at")
  approvalDecision CheckpointDecision? @map("approval_decision")
  approvalAuthorship QuestionAuthorship? @map("approval_authorship")
  approvalRequestId String? @map("approval_request_id")
  approvalPayloadHash String? @map("approval_payload_hash")
  approvalConsumedAt DateTime? @map("approval_consumed_at")
  applicationQuestionId String? @map("application_question_id")
  applicationQuestion ApplicationQuestion? @relation(fields:[applicationQuestionId], references:[id], onDelete:SetNull)
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        PilotQuestionKind
  status      PilotQuestionStatus @default(open)
  subjectType String?             @map("subject_type")
  subjectId   String?             @map("subject_id")
  prompt      String
  options     Json                @default("[]")
  deepLink    String?             @map("deep_link")
  answer      String?
  answeredAt  DateTime?           @map("answered_at")
  expiresAt   DateTime?           @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([applicationQuestionId])
  @@unique([userId,approvalRequestId])
  @@index([approvalAttemptId,approvalCheckpointId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("pilot_questions")
}

model PilotJournalEntry {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String?          @map("cycle_id")
  kind        PilotJournalKind
  summary     String
  detail      Json             @default("{}")
  subjectType String?          @map("subject_type")
  subjectId   String?          @map("subject_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@map("pilot_journal_entries")
}

model PromotionPost {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  target       String?
  title        String?
  body         String
  status       PromotionStatus @default(draft)
  postedUrl    String?         @map("posted_url")
  scheduledFor DateTime?       @map("scheduled_for")
  postedAt     DateTime?       @map("posted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([updatedAt]) // Retention sweep; the userId-leading index cannot serve it.
  @@map("promotion_posts")
}
