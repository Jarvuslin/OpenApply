model Reference {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  position     Int     @default(0)

  @@index([userId])
  @@map("references")
}

model SalaryPreference {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliesTo String @map("applies_to")
  minAmount Float? @map("min_amount")
  maxAmount Float? @map("max_amount")
  currency  String @default("USD")
  period    String @default("yearly")
  position  Int    @default(0)

  @@index([userId])
  @@map("salary_preferences")
}

model AutoApplySettings {
  id                         String @id @default(uuid())
  userId                     String @unique @map("user_id")
  user                       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  minMatchScore              Int    @default(60) @map("min_match_score")
  maxApplicationsPerCampaign Int?   @map("max_applications_per_campaign")
  defaultStartDate           String @default("") @map("default_start_date")

  @@map("auto_apply_settings")
}
