enum CampaignJobStatus {
  queued
  pending
  approved
  applying
  applied
  failed
  skipped
  needs_user

  @@map("campaign_job_status")
}

model Job {
  intake JobIntake?
  intakeDecisionRequired Boolean @default(false) @map("intake_decision_required")
  humanApprovalRequired Boolean @default(false) @map("human_approval_required")
  documentSelections ApplicationDocumentSelection[]
  preparationResults ApplicationPreparationResult[]
  questionCollections JobQuestionCollection[]
  applicationQuestions ApplicationQuestion[]
  workItem WorkItem?
  submissionAttempt SubmissionAttempt?
  pilotResult PilotResult?
  id          String            @id @default(uuid())
  campaignId  String            @map("campaign_id")
  campaign    Campaign          @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  key         String
  title       String
  company     String
  location    String?
  salary      String?
  type        String?
  url         String
  board       String?
  matchScore  Int?              @map("match_score")
  matchReason String?           @map("match_reason")
  fitAssessment Json?           @map("fit_assessment")
  status      CampaignJobStatus @default(pending)
  appliedAt   DateTime?         @map("applied_at")
  failReason  String?           @map("fail_reason")
  retryNotes  String?           @map("retry_notes")
  skipReason  String?           @map("skip_reason")
  description String?
  digest      String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([campaignId, key])
  @@index([campaignId, status])
  // The application detail resolves its posting by url within the campaign; no FK links the two.
  @@index([campaignId, url])
  @@index([status, updatedAt])
  // The pilot activity probe takes MAX(updatedAt) across a user's campaigns every two minutes.
  @@index([campaignId, updatedAt])
  @@map("jobs")
}
