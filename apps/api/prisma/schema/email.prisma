enum EmailProvider {
  connector
  gmail
  outlook
  imap

  @@map("email_provider")
}

enum EmailRuntimeProvider {
  claude
  codex

  @@map("email_runtime_provider")
}

// What the scan decided a message is about.
enum EmailClassification {
  interviewing
  rejected
  offer
  irrelevant
  verification

  @@map("email_classification")
}

// Whether the user has acted on a scanned message.
enum EmailReviewStatus {
  pending
  approved
  denied
  auto

  @@map("email_review_status")
}

// A saved mailbox; selection is separate so switching never removes imported messages.
model EmailAccount {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation("UserMailboxes", fields: [userId], references: [id], onDelete: Cascade)
  activeForUser  User?     @relation("ActiveMailbox")
  provider       EmailProvider
  email          String
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  scope          String?
  historyId      String?   @map("history_id")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastCheckedAt  DateTime? @map("last_checked_at")
  runtimeProvider EmailRuntimeProvider? @map("runtime_provider")
  // False when read access was checked but the address was confirmed by the user.
  identityVerified Boolean @default(false) @map("identity_verified")
  // Rejected token refresh (invalid_grant): the mailbox needs reconnecting. Cleared on success.
  refreshFailedAt DateTime? @map("refresh_failed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages EmailMessage[]

  @@unique([userId, email])
  @@map("email_accounts")
}

// Per-user Google OAuth client; separate from EmailAccount so it pre-dates connection and survives disconnect.
model EmailOAuthClient {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     EmailProvider @default(gmail)
  clientId     String   @map("client_id") // plaintext (semi-public)
  clientSecret String   @map("client_secret") // ciphertext (per-user DEK)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_oauth_clients")
}

// A fetched message plus the scan results: classification, the application it matched, and any verification code or link found.
model EmailMessage {
  id          String       @id @default(uuid())
  accountId   String       @map("account_id")
  account     EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerId  String       @map("provider_id")
  threadId    String?      @map("thread_id")
  subject     String
  fromAddress String       @map("from_address")
  toHeader    String?      @map("to_header")
  fromName    String?      @map("from_name")
  fromDomain  String       @map("from_domain")
  snippet     String
  rawBody     String       @map("raw_body")
  receivedAt  DateTime     @map("received_at")
  fetchedAt   DateTime     @default(now()) @map("fetched_at")

  scannedAt      DateTime?    @map("scanned_at")
  classification EmailClassification?
  confidence     Float?
  reasoning      String?
  matchedAppId   String?      @map("matched_app_id")
  matchedApp     Application? @relation(fields: [matchedAppId], references: [id], onDelete: SetNull)
  matchScore     Float?       @map("match_score")
  reviewStatus   EmailReviewStatus  @default(pending) @map("review_status")
  appliedStatus  ApplicationStatus? @map("applied_status")

  verificationCode   String? @map("verification_code")
  verificationLink   String? @map("verification_link")
  verificationDomain String? @map("verification_domain")

  @@unique([accountId, providerId])
  @@index([reviewStatus, receivedAt])
  @@index([matchedAppId])
  @@index([fromDomain, receivedAt])
  @@index([verificationDomain, receivedAt])
  @@index([receivedAt]) // Retention sweep; every other index leads with a column it does not filter on.
  @@map("email_messages")
}
