{
  "name": "openapply",
  "version": "2.1.38",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently -k -n terminal,api,web -c cyan,magenta,green \"dotnet run --project apps/terminal --no-build\" \"bun --cwd=apps/api run src/app.ts\" \"bun --cwd=apps/web run start\"",
    "dev": "concurrently -k -n terminal,api,web -c cyan,magenta,green \"dotnet run --project apps/terminal\" \"bun --cwd=apps/api run dev\" \"bun --cwd=apps/web run dev\"",
    "dev:api": "bun --cwd=apps/api run dev",
    "dev:web": "bun --cwd=apps/web run dev",
    "dev:terminal": "dotnet run --project apps/terminal",
    "test": "bun --cwd=apps/api run test && bun --cwd=packages/contracts run test && bun --cwd=apps/web run test && bun run test:node",
    "test:node": "node scripts/node-tests/run.mjs",
    "test:node:browser": "node scripts/node-tests/run.mjs --group=browser",
    "test:node:guest-host": "node scripts/node-tests/run.mjs --group=guest-host",
    "test:apply-e2e": "node scripts/node-tests/run.mjs --prefix=scripts/apply-e2e/ --prefix=plugin/bin/browser-options.test.mjs",
    "apply:e2e": "node scripts/apply-e2e/run.mjs",
    "apply:ui": "node scripts/apply-e2e/ui-run.mjs",
    "queue:verify": "node scripts/queue-regression/run.mjs",
    "test:queue": "node scripts/node-tests/run.mjs --prefix=scripts/queue-regression/ --prefix=plugin/bin/api-queue.test.mjs",
    "questions:verify": "node scripts/questions-regression/run.mjs",
    "test:questions": "node scripts/node-tests/run.mjs --prefix=scripts/questions-regression/",
    "test:question-collector": "node scripts/node-tests/run.mjs --group=browser --prefix=plugin/bin/question-collector.test.mjs",
    "answers:verify": "node scripts/answer-bank-regression/run.mjs",
    "test:answers": "node scripts/node-tests/run.mjs --prefix=scripts/answer-bank-regression/",
    "preparation:verify": "node scripts/preparation-regression/run.mjs",
    "test:preparation": "node scripts/node-tests/run.mjs --prefix=scripts/preparation-regression/",
    "scoring:verify": "node scripts/scoring-regression/run.mjs",
    "test:scoring": "node scripts/node-tests/run.mjs --prefix=scripts/scoring-regression/ && bun --cwd=apps/api test scripts/scoring-regression-corpus.test.ts",
    "concurrency:verify": "node scripts/concurrency-regression/run.mjs",
    "test:concurrency": "node scripts/node-tests/run.mjs --prefix=scripts/concurrency-regression/",
    "telegram:verify": "node scripts/telegram-regression/run.mjs",
    "test:telegram": "node scripts/node-tests/run.mjs --prefix=scripts/telegram-regression/",
    "queue-experience:verify": "node scripts/queue-experience-regression/run.mjs",
    "test:queue-experience": "node scripts/node-tests/run.mjs --prefix=scripts/queue-experience-regression/",
    "db:tunnel": "bash apps/api/scripts/db-tunnel.sh",
    "db:setup": "bun --cwd=apps/api run db:generate && bun --cwd=apps/api run db:migrate:apply && bun --cwd=apps/api run db:seed",
    "build:api": "bun --cwd=apps/api run build",
    "build:web": "bun --cwd=apps/web run build",
    "build:terminal": "dotnet publish apps/terminal -c Release -o dist/terminal",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "ci": "biome ci --error-on-warnings .",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "concurrently": "^10.0.5",
    "knip": "^6.38.0"
  }
}
