# Production environment for the OpenApply stack.
# On deploy this file is written from the ENV_DOCKER GitHub secret, and the
# workflow appends GITHUB_REPOSITORY=<owner>/<repo> (lowercased) for the image refs.

# --- Database (external / managed Postgres) ---
GITHUB_REPOSITORY=jarvuslin/openapply
MVP_LOCAL_RUNNER=false
DATABASE_URL=postgresql://user:password@db-host:5432/openapply

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Wraps each user's data-encryption key. Generate with: openssl rand -base64 32
SECRET_MASTER_KEY=change-me-base64-of-32-bytes

# The single super admin
SUPER_ADMIN_EMAIL=

# --- URLs (single origin) ---
CORS_ORIGINS=https://apply.your-domain.example
APP_URL=https://apply.your-domain.example
GOOGLE_OAUTH_REDIRECT_URI=https://apply.your-domain.example/api/email/oauth/callback

# --- Google/GitHub sign-in (shared app OAuth clients; unset = provider disabled) ---
# Register callbacks: {AUTH_OAUTH_REDIRECT_BASE}/api/auth/providers/{google,github}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_OAUTH_REDIRECT_BASE=https://apply.your-domain.example

# --- Storage ---
STORAGE_ROOT=./storage

# --- Email (required in production; verified sending domain) ---
RESEND_API_KEY=
EMAIL_FROM=OpenApply <noreply@apply.your-domain.example>

LOG_LEVEL=info
